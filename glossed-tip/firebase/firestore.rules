rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /services/{id} { allow read: if true; allow write: if isAdmin(); }
    match /portfolioSets/{id} { allow read: if true; allow write: if isAdmin(); }
    match /businessSettings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /users/{uid} {
      allow read, update, create: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /addresses/{addressId} { allow read, write: if isOwner(uid) || isAdmin(); }
      match /favorites/{favoriteId} { allow read, write: if isOwner(uid) || isAdmin(); }
    }

    match /appointments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if false; // Created through trusted Cloud Functions after hold/payment validation.
      allow update, delete: if isAdmin();
    }

    match /paymentHolds/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false; // Cloud Functions only.
    }

    match /waitlist/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
    }

    match /availability/{id} { allow read: if true; allow write: if isAdmin(); }
    match /blockedTime/{id} { allow read, write: if isAdmin(); }
  }
}
